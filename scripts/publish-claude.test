#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT

export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.com
export GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.com
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GITHUB_REPOSITORY=owner/repo

failures=0
cases=0

fail() {
  echo "FAIL: $1" >&2
  failures=$((failures + 1))
}

mkdir -p "${tmp}/fakebin"
cat > "${tmp}/fakebin/gh" <<'SH'
#!/usr/bin/env bash
echo "$*" >> "${FAKE_LOG}"
case "$1 $2" in
  "pr create") echo "https://example.com/pull/7" ;;
esac
SH
chmod +x "${tmp}/fakebin/gh"
export PATH="${tmp}/fakebin:${PATH}"

new_repo() {
  repo="${tmp}/$1"
  git init -q --bare -b main "${repo}.git"
  git init -q -b main "${repo}"
  cd "${repo}"
  git remote add origin "${repo}.git"
  mkdir scripts
  cp "${here}/publish-claude-feedback" "${here}/publish-claude-pr" scripts/
  cat > scripts/push-signed-commits <<'SH'
#!/usr/bin/env bash
echo "push $*" >> "${FAKE_LOG}"
SH
  chmod +x scripts/*
  echo one > keep.txt
  git add keep.txt scripts
  git commit -q -m base
  git push -q origin main
  export FAKE_LOG="${tmp}/$1.log"
  : > "${FAKE_LOG}"
  printf 'title\n' > "${tmp}/title"
  printf 'body\n' > "${tmp}/body"
}

run() {
  set +e
  out="$("$@" 2>&1)"
  rc=$?
  set -e
}

commit_on() {
  git checkout -q -b "$1"
  echo change >> keep.txt
  git add keep.txt
  git commit -q -m change
}

cases=$((cases + 1))
new_repo feedback-detached
git checkout -q --detach
run scripts/publish-claude-feedback
[ "$rc" -eq 0 ] || fail "detached head exited ${rc}: ${out}"
[ ! -s "${FAKE_LOG}" ] || fail "detached head pushed"

cases=$((cases + 1))
new_repo feedback-main
run scripts/publish-claude-feedback
[ "$rc" -eq 0 ] || fail "main exited ${rc}: ${out}"
[ ! -s "${FAKE_LOG}" ] || fail "main pushed"

cases=$((cases + 1))
new_repo feedback-none
git checkout -q -b pr-branch
git push -q origin pr-branch
run scripts/publish-claude-feedback
[ "$rc" -eq 0 ] || fail "no new commits exited ${rc}: ${out}"
[ ! -s "${FAKE_LOG}" ] || fail "no new commits pushed"

cases=$((cases + 1))
new_repo feedback-commits
git checkout -q -b pr-branch
git push -q origin pr-branch
echo change >> keep.txt
git add keep.txt
git commit -q -m change
run scripts/publish-claude-feedback
[ "$rc" -eq 0 ] || fail "new commits exited ${rc}: ${out}"
grep -qx "push owner/repo pr-branch origin/pr-branch" "${FAKE_LOG}" || fail "commits not replayed: $(cat "${FAKE_LOG}")"

cases=$((cases + 1))
new_repo feedback-noremote
commit_on pr-branch
run scripts/publish-claude-feedback
[ "$rc" -ne 0 ] || fail "missing origin branch passed silently"
[ ! -s "${FAKE_LOG}" ] || fail "missing origin branch pushed"

cases=$((cases + 1))
new_repo pr-main
run scripts/publish-claude-pr 5 someone "${tmp}/title" "${tmp}/body"
[ "$rc" -eq 0 ] || fail "pr on main exited ${rc}: ${out}"
[ ! -s "${FAKE_LOG}" ] || fail "pr on main published"

cases=$((cases + 1))
new_repo pr-none
git checkout -q -b new-template/issue-5
run scripts/publish-claude-pr 5 someone "${tmp}/title" "${tmp}/body"
[ "$rc" -eq 0 ] || fail "pr without commits exited ${rc}: ${out}"
[ ! -s "${FAKE_LOG}" ] || fail "pr without commits published"

cases=$((cases + 1))
new_repo pr-nodraft
commit_on new-template/issue-5
run scripts/publish-claude-pr 5 someone "${tmp}/missing" "${tmp}/body"
[ "$rc" -ne 0 ] || fail "missing draft passed silently"
[ ! -s "${FAKE_LOG}" ] || fail "missing draft published"

cases=$((cases + 1))
new_repo pr-commits
commit_on new-template/issue-5
run scripts/publish-claude-pr 5 someone "${tmp}/title" "${tmp}/body"
[ "$rc" -eq 0 ] || fail "pr with commits exited ${rc}: ${out}"
grep -qx "push owner/repo new-template/issue-5 origin/main" "${FAKE_LOG}" || fail "commits not replayed"
grep -q "^pr create --head new-template/issue-5 --base main --title title --body-file ${tmp}/body --reviewer datum-cloud/gtm" "${FAKE_LOG}" || fail "pr not created"
grep -q '^issue comment 5 --body @someone .*https://example.com/pull/7' "${FAKE_LOG}" || fail "issue not commented"

cases=$((cases + 1))
run scripts/publish-claude-pr 5
[ "$rc" -eq 2 ] || fail "bad usage exited ${rc}"

if [ "${failures}" -ne 0 ]; then
  echo "${failures} failure(s) in ${cases} cases" >&2
  exit 1
fi
echo "ok: ${cases} cases"
